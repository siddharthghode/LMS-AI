# LMS-AI Environment Configuration

# Backend Core Server
NODE_ENV=development
PORT=5000
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Authentication Secrets
JWT_SECRET=dev-jwt-secret-key-change-in-production-lms-ai-2026
JWT_REFRESH_SECRET=dev-refresh-jwt-secret-key-change-in-production-lms-ai-2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Database Configuration (PostgreSQL 16 + pgvector)
DB_HOST=localhost
DB_PORT=5433
DB_USER=lms_admin
DB_PASSWORD=lms_dev_password
DB_NAME=lms_ai_db
DATABASE_URL=postgresql://lms_admin:lms_dev_password@localhost:5433/lms_ai_db

# Redis Cache & Queue
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# Object Storage / Uploads
STORAGE_TYPE=local
UPLOAD_DIR=uploads
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# AI Service (Python / FastAPI)
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://localhost:8000

# LLM Providers (Optional for local offline development; offline fallback included)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_AI_BASE_URL=http://localhost:8000
